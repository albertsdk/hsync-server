# HSYNC Server - Production Environment Configuration
# Copy this file and customize for your environment

# Server Configuration
HSYNC_PORT=8765
# WARNING: Multi-worker mode (>1) is NOT supported!
# WebSocket connections and MD5 cache are NOT shared between workers.
# Keep HSYNC_WORKERS=1 until Redis/shared state is implemented.
HSYNC_WORKERS=1
HSYNC_LOG_LEVEL=info

# Timezone (IANA format)
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
HSYNC_TZ=Europe/Rome

# API Key for authentication (required)
# Generate a secure key at: https://it-tools.tech/token-generator
# IMPORTANT: Change this to a secure random value in production!
HSYNC_API_KEY=

