# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
**/*.pyc
**/__pycache__
*.pyo

# Virtual environment
.env
.venv
venv/
ENV/

# Git
.git
.gitignore
.gitattributes

# Unit test / coverage
.coverage
coverage/
htmlcov/
.pytest_cache/
.tox/
.nox/

# Build / Distribution
/build/
/dist/
/tmp/
*.egg-info/
*.egg
*.whl

# IDE settings
.idea/
.vscode/
*.swp
*.swo
*~

# OS specific
.DS_Store
Thumbs.db

# Project specific
/buckets/
/certs/
/state/
.hsync-last-env-file
# Defensive copies left behind by docker.sh's one-shot
# bind-mount → named-volume data migration.
/state.migrated-*/
/buckets.migrated-*/

# Logs
*.log

# Qt specific (for hsync-desktop)
*.qmlc
*.jsc

# Python compiled
*.spec (PyInstaller)

# Kilo
.kilo

