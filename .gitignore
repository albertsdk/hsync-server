# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
**/*.pyc
**/__pycache__
*.pyo

# Virtual environment
.env
.venv
venv/
ENV/

# Local environment files (copy from the committed *.env.example templates)
dev.env
prod.env

# Git
.git
.gitignore
.gitattributes

# Unit test / coverage
.coverage
coverage/
htmlcov/
.pytest_cache/
.tox/
.nox/

# Build / Distribution
/build/
/dist/
/tmp/
*.egg-info/
*.egg
*.whl

# IDE settings
.idea/
.vscode/
*.swp
*.swo
*~

# OS specific
.DS_Store
Thumbs.db

# Project specific
# Host data directory used by docker.sh (bind-mounted into the container).
/hsync-data/
.hsync-last-env-file
# Historical paths: local dev data and the repo layout from older setups.
/buckets/
/certs/
/state/
/state.migrated-*/
/buckets.migrated-*/

# Logs
*.log

# Qt specific (for hsync-desktop)
*.qmlc
*.jsc

# Python compiled
*.spec (PyInstaller)

# Kilo
.kilo

# Cache
.mypy_cache
.ruff_cache

# HSYNC
.hsynckeep
