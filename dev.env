# HSYNC Server - Development Environment Configuration
# Copy this file and customize for your environment

# Server Configuration
HSYNC_PORT=9753
# WARNING: Multi-worker mode (>1) is NOT supported!
# WebSocket connections and SHA-256 cache are NOT shared between workers.
# Keep HSYNC_WORKERS=1 until Redis/shared state is implemented.
HSYNC_WORKERS=1
HSYNC_LOG_LEVEL=debug

# Timezone (IANA format)
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
HSYNC_TZ=Europe/Rome

# Storage Configuration
# Absolute directory where bucket data is stored. Inside the container this
# is the canonical /project/buckets mount point; outside it must be an
# absolute path (relative values are resolved against the process CWD).
HSYNC_BUCKETS=/project/buckets

# Installation causal-state database (versions + tombstones). Outside buckets.
HSYNC_STATE_DIR=/project/state

# Bootstrap admin secret (optional, 64 lowercase hex chars)
# If set, the server uses it as the bootstrap admin's secret key (silent).
# If absent, the server generates one and prints the full token once at startup.
# Generate with: openssl rand -hex 32
HSYNC_ADMIN_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Upload and disk-space limits
# Maximum upload size in bytes (default: 10 GiB)
HSYNC_MAX_UPLOAD_SIZE=10737418240
# Minimum free disk space before accepting uploads (0 = disabled, default: 500 MiB)
HSYNC_MIN_FREE_DISK_SPACE=524288000

# CORS Configuration
HSYNC_CORS_ENABLED=false
HSYNC_CORS_ORIGINS=

# Rate Limiting Configuration
# Format: "<number>/<period>" where period is: second, minute, hour, day
# These are high-traffic defaults; adjust based on your needs
HSYNC_RATE_LIMIT_DEFAULT=500/minute
HSYNC_RATE_LIMIT_UPLOAD=200/minute
HSYNC_RATE_LIMIT_DOWNLOAD=1000/minute
HSYNC_RATE_LIMIT_WEBSOCKET=50/minute
HSYNC_RATE_LIMIT_WS_MESSAGES=10/second
# Comma-separated reverse-proxy IPs allowed to set X-Forwarded-For.
# Leave empty unless the server is behind a trusted proxy.
HSYNC_TRUSTED_PROXIES=

# WebSocket Configuration
HSYNC_WS_HEARTBEAT_INTERVAL=30
HSYNC_WS_HEARTBEAT_TIMEOUT=10
HSYNC_WS_AUTH_TIMEOUT=10
HSYNC_WS_MAX_CONNECTIONS=1000
HSYNC_WS_MAX_CONNECTIONS_PER_IP=10

# Tombstone retention window in days (0 = forever)
HSYNC_TOMBSTONE_TTL_DAYS=30

# SSL/TLS Configuration (optional)
# Enable HTTPS/WSS with self-signed certificates for encrypted communication
# Set to "true" to enable SSL (certificates will be auto-generated if not provided)
HSYNC_SSL_ENABLED=true

# Password used to encrypt/decrypt the SSL private key on disk.
# REQUIRED when HSYNC_SSL_ENABLED=true: private keys are never stored in
# clear text. The same password must be used for the lifetime of the key file.
# In production, source this value from a secret manager (vault, k8s secret,
# systemd-creds, ...) instead of hard-coding it here.
HSYNC_SSL_KEYFILE_PASSWORD=dev-ssl-key-password-change-me

# Custom certificate paths (optional, auto-generated if not set)
# HSYNC_SSL_CERTFILE=/path/to/server.crt
# HSYNC_SSL_KEYFILE=/path/to/server.key

# Directory for auto-generated certificates (default: ./certs)
# HSYNC_SSL_CERT_DIR=./certs

# =============================================================================
# Log Rotation Settings
# =============================================================================
# These settings apply when HSYNC_LOG_FILE is set.
# Loguru handles rotation automatically based on these parameters.

# Path to log file (enables file logging in addition to console)
# If not set, logs are only written to console
# HSYNC_LOG_FILE=./logs/hsync-server.log

# Log output format: text or json
# HSYNC_LOG_FORMAT=text

# When to rotate the log file
# Examples: "10 MB", "100 MB", "1 GB", "1 day", "1 week", "00:00" (midnight)
# Default: 10 MB
# HSYNC_LOG_ROTATION=10 MB

# How long to keep old log files
# Examples: "7 days", "1 month", "3 months", "5" (keep 5 files)
# Default: 7 days
# HSYNC_LOG_RETENTION=7 days

# Compression format for rotated logs
# Options: gz, bz2, xz, lzma, tar, tar.gz, tar.bz2, tar.xz, zip
# Default: xz
# HSYNC_LOG_COMPRESSION=xz

# =============================================================================
# Transfer Settings
# =============================================================================

# Enable zstd compression for file transfers
# When enabled, files are compressed before transfer if beneficial
# (skips small files and already-compressed formats like jpg, zip, etc.)
# Default: true
# HSYNC_COMPRESSION_ENABLED=true

# =============================================================================
# Development Settings
# =============================================================================

# Enable uvicorn auto-reload (development only)
# Set to "true" for hot-reload on code changes during development
# Default: false
HSYNC_RELOAD=true

# Expose /docs (Swagger UI) and /redoc API documentation
# Enabled in development, disabled by default in production
HSYNC_ENABLE_DOCS=true
